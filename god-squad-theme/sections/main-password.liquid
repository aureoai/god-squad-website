{%- comment -%}
  GOD SQUAD — Password
  The surface Shopify serves when the store is behind the storefront password
  gate. Without this template the merchant sees Shopify's default password
  page, which does not match anything else in the theme.

  Sources of truth:
  - PHASE-2-DESIGN-SYSTEM.md §8 (container), §10.1 (accent variant on dark
    surfaces only), §26.2 (narrow measure for a single explanatory line).
  - sections/main-404.liquid, which this file models on: the shape of the
    page is a heading, one line of copy and one control, on a dark surface.

  THE COPY IS GENERIC UI COPY, NOT BRAND COPY.
  The heading, the tagline and the label are locale strings. The merchant may
  edit the tagline through Shopify admin's own password page settings; nothing
  brand-facing is frozen into this template.

  ZERO JavaScript.
{%- endcomment -%}

{{ 'section-main-password.css' | asset_url | stylesheet_tag }}

<div class="main-password surface-dark" {{ section.shopify_attributes }}>
  <div class="main-password__inner container">
    <p class="main-password__eyebrow">{{ shop.name }}</p>
    <h1 class="main-password__title">{{ 'general.password_page.opening_soon' | t }}</h1>

    {%- if shop.password_message != blank -%}
      <div class="main-password__body rte">{{ shop.password_message }}</div>
    {%- else -%}
      <p class="main-password__body">{{ 'general.password_page.default_message' | t }}</p>
    {%- endif -%}

    {%- form 'storefront_password', class: 'main-password__form' -%}
      <label class="main-password__label" for="Password">
        {{ 'general.password_page.password_label' | t }}
      </label>

      <div class="main-password__field">
        <input
          type="password"
          name="password"
          id="Password"
          class="main-password__input"
          autocomplete="current-password"
          {% if form.errors %}aria-invalid="true"{% endif %}
          placeholder="{{ 'general.password_page.password_placeholder' | t }}"
        >

        <button type="submit" class="button button--accent main-password__submit">
          {{ 'general.password_page.enter' | t }}
          {% render 'icon-arrow' %}
        </button>
      </div>

      {%- if form.errors -%}
        <p class="main-password__error" role="alert">
          {{ 'general.password_page.wrong_password' | t }}
        </p>
      {%- endif -%}
    {%- endform -%}

    <p class="main-password__admin">
      {{ 'general.password_page.admin_link_html' | t: shop_url: shop.url }}
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "class": "main-password-section",
  "settings": [],
  "enabled_on": {
    "templates": ["password"]
  }
}
{% endschema %}
